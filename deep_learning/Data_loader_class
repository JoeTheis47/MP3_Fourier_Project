class Audio_data_set(Dataset):
    def __init__(self,audio_dir):
        self.note_frequencies = {
        "A2": 110,
        "B3": 246.94,
        "D3": 146.83,
        "E2": 82.41,
        "E4": 329.63,
        "G3": 196.00}

        self.audio_data,self.frequencies = self.open_data(audio_dir,2048,4)

    def __len__(self):
        return len(self.frequencies)
    
    def __getitem__(self,index):
        label = self.frequencies[index]
        signal = self.audio_data[index]
        return signal,label

    def open_data(self,directory,frame_len,frame_quantity):
        # takes a file directory, opens all files within it and determines the note based on a _(note) at the end (not comprehensive; to add)
        # then breaks apart the files into it's plucks, and returns it all as one 
        # indexed file with evenly segmented samples and with sound data attached
        file = Path(directory)
        files = list(file.iterdir())

        frame_freq = []
        sample = []

        for i in range(0,len(files)):
            freq_decoder = files[i].stem.split("_")[-1]
            frequency = self.note_frequencies[freq_decoder]
            sr,values = scipy.io.wavfile.read(files[i])
            frames,strikes = os(values,frame_len,sr)

            for j in strikes:

                frame_freq.append(frequency)

                segment = np.abs(np.fft.rfft(values[j*frame_len//2:(j+frame_quantity)*frame_len//2]))
                wave = np.log1p(segment/(np.max(segment) + 1e-8))
                sample.append(torch.tensor(wave,dtype=torch.float32))

        self.sample_rate = sr

        return sample,frame_freq
