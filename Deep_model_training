from torch.utils.data import Dataset,DataLoader
import scipy
from pathlib import Path
from audio_processing import onset_detection as os
import torch
import numpy as np
import torch.nn as nn

# for the verification of this model, input a file into line 103 with all the same conent


class Audio_data_set(Dataset):
    def __init__(self,audio_dir):
        self.note_frequencies = {
        "A2": 110,
        "B3": 246.94,
        "D3": 146.83,
        "E2": 82.41,
        "E4": 329.63,
        "G3": 196.00}

        self.audio_data,self.frequencies = self.open_data(audio_dir,2048,4)

    def __len__(self):
        return len(self.frequencies)
    
    def __getitem__(self,index):
        label = self.frequencies[index]
        signal = self.audio_data[index]
        return signal,label

    def open_data(self,directory,frame_len,frame_quantity):
        # takes a file directory, opens all files within it and determines the note based on a _(note) at the end (not comprehensive; to add)
        # then breaks apart the files into it's plucks, and returns it all as one 
        # indexed file with evenly segmented samples and with sound data attached
        file = Path(directory)
        files = list(file.iterdir())

        frame_freq = []
        sample = []

        for i in range(0,len(files)):
            freq_decoder = files[i].stem.split("_")[-1]
            frequency = self.note_frequencies[freq_decoder]
            sr,values = scipy.io.wavfile.read(files[i])
            frames,strikes = os(values,frame_len,sr)

            for j in strikes:

                frame_freq.append(frequency)

                segment = np.abs(np.fft.rfft(values[j*frame_len//2:(j+frame_quantity)*frame_len//2]))
                wave = np.log1p(segment/(np.max(segment) + 1e-8))
                sample.append(torch.tensor(wave,dtype=torch.float32))

        self.sample_rate = sr

        return sample,frame_freq

class model(nn.Module):
    def __init__(self):
        super().__init__()

        # set up 5 layers. The first 3 are to identify how the amplitudes change, making them convolutional layers, so that they
        # can take in data coming in from a small section of time
        #  the last two are linear layers, to connect and compact the information output from the convolutional layers into an 
        # estimation
        self.L1 = nn.Conv1d(1,8,kernel_size=9,padding=4,stride = 2)
        #self.B1 = nn.BatchNorm1d(8)

        self.L2 = nn.Conv1d(8,16,kernel_size = 9,padding = 4,stride = 2)
        #self.B2 = nn.BatchNorm1d(16)       # commenting this off means taking it out of each of the functional layers. So remember to add back in after relu

        self.L3 = nn.Conv1d(16,32,kernel_size=9,padding=4,stride = 2)
        #self.B3 = nn.BatchNorm1d(32)

        self.L4 = nn.Linear(32*257,32)

        self.L5 = nn.Linear(32,1)


    def forward(self,x):
        # this forward function is a key one in Torch.Module, as it is immediately called if an input is given to the module function
        # this one connects all the predefined layers and then returns their single number output. The model will be trained onto
        # a logarithm of the root frequency output instead of the actual frequency because logarithmic frequecy increases linearly for frequency

        x = nn.functional.relu(self.L1(x)) # relu is weird. theres too much to be said about it in one comment, but its practically np.max(f,0)
        # essentially, its a max(num,0), though apparently more efficient. 
        x = nn.functional.relu(self.L2(x))

        x = nn.functional.relu(self.L3(x))

        x = x.flatten(1)

        x = nn.functional.relu(self.L4(x))

        x = self.L5(x)

        return x


if __name__ == "__main__":
    data_set = Audio_data_set(r"C:\Users\joeth\OneDrive\Documents\sound_data_file\sound_data")

    deep_model = model()

    dataloader = DataLoader(data_set,batch_size=9,shuffle=False)
    opt = torch.optim.Adam(deep_model.parameters(),lr = .001)
    lossfunc = nn.MSELoss()

    for epoch in range(0,500):
        deep_model.train()
        for frames,frequencies in dataloader:
            
            frames = frames.unsqueeze(1)
            frequency = torch.log2(frequencies/440)

            pred = deep_model(frames.float())

            loss = lossfunc(pred.squeeze(1),frequency)

            opt.zero_grad()
            loss.backward()
            opt.step()

        print(f"epoch:{epoch},loss:{loss}")
    with torch.no_grad():

        for frames, frequencies in dataloader:

            frames = frames.unsqueeze(1)
            pred = deep_model(frames).squeeze(1)

    
    torch.save(deep_model.state_dict(), "guitar_frequency_model.pth")
