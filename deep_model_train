from torch.utils.data import DataLoader
import torch
import numpy as np
import torch.nn as nn
import audio_analysis as au
import model
from data_loader import Audio_data_set

if __name__ == "__main__":
    frame_len = 2048
    hop_percent = 50
    frames_analyzed = 4

    analyzed_frames = []
    segment = []

    data_set = Audio_data_set(r(input file path here to learning data),frame_len,frames_analyzed=frames_analyzed)
    dataloader = DataLoader(data_set,batch_size=9,shuffle=True)


    deep_model = model.model(frames_analyzed)
    opt = torch.optim.Adam(deep_model.parameters(),lr = .001)
    lossfunc = nn.MSELoss()

    operand = au.audio_file_operator(r(input file path here to testing data),frame_len,hop_percent,frames_analyzed)

    guitar_strikes = operand.onsets

    window = np.hanning(frame_len)


    analyzed_frames = torch.tensor(operand.onset_frames)

    for epoch in range(0,500):
        deep_model.train()
        for frames,frequencies in dataloader:
            frequency = torch.log2(frequencies/440)

            pred = deep_model(frames.float())

            loss = lossfunc(pred.squeeze(1),frequency)

            opt.zero_grad()
            loss.backward()
            opt.step()

        #print(f"epoch:{epoch},loss:{loss}")
        deep_model.eval()
        with torch.no_grad():
            pred = deep_model(analyzed_frames.float()).squeeze()
            hz = np.array(440 * (2 ** pred))
            print(f"Predicted: {hz} Hz")
            print(f"avg: {np.mean(hz)} Hz")
        deep_model.train()

    torch.save(deep_model.state_dict(), "guitar_frequency_model.pth")
# the structure is (batchsize,channels,samples)
# there should always be just one channel for audio stuff, but batchsize may vary depending on the length of the input
# input cannot be stereo data: stereo data has 2 channels, not one. It needs some adjustment to be worked in

    deep_model.eval()

    with torch.no_grad():
        pred = deep_model(analyzed_frames.float())
        target_vals = [np.log2(146.83/440) for i in guitar_strikes]
        target = torch.tensor(target_vals,dtype=torch.float32).unsqueeze(1) 

    print(pred)
    print(target)
    print(2**pred*440)
